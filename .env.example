# Required in production. The shared password protects the Git Master UI.
APP_PASSWORD=change-this-password
APP_SECRET=replace-with-at-least-32-random-characters

# Used to encrypt GitHub access tokens at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters

# Optional: enables speech transcription, automatic titles, and natural-language commands.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TEXT_MODEL=gpt-4o-mini

# Storage and GitHub defaults
DATABASE_PATH=./data/git-master.db
GITHUB_API_URL=https://api.github.com
GITHUB_UPLOAD_BRANCH=
NEXT_PUBLIC_APP_NAME=Git Master
