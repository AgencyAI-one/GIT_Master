{
  "name": "git-master",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-first GitHub issue and project management workspace",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
